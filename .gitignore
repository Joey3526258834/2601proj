# ==============================================
# 通用C/C++编译产物
# ==============================================
# 目标文件
*.o
*.ko
*.obj
*.elf

# 链接器输出
*.ilk
*.map
*.exp

# 预编译头
*.gch
*.pch

# 库文件
*.lib
*.a
*.la
*.lo

# 共享库
*.dll
*.so
*.so.*
*.dylib

# 可执行文件
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# 调试文件
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# 交叉编译依赖文件
*.d
*.i
*.s

# ==============================================
# Linux内核模块编译产物
# ==============================================
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# ==============================================
# 嵌入式项目特有的构建目录
# ==============================================
build/
obj/
bin/
lib/
output/
Debug/
Release/

# ==============================================
# LVGL相关临时文件
# ==============================================
lv_conf.h.bak
lv_drv_conf.h.bak
lvgl_conf.h.bak

# ==============================================
# 开发工具和系统临时文件
# ==============================================
*.log
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==============================================
# Git相关临时文件
# ==============================================
*.gitmodules.bak
